# Backend Environment Configuration
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# ─── Database ─────────────────────────────────────────────────────
# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///./app.db

# PostgreSQL (optional, for production):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/customer_segmentation

# ─── Security ─────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_real_secret_key

# ─── Application ──────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── WhatsApp Business API ────────────────────────────────────────
# Leave these empty in development — mock adapter is used by default.
# Set WHATSAPP_LIVE_MODE=true ONLY when you have verified credentials
# and are intentionally sending real messages.
WHATSAPP_LIVE_MODE=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ─── RFM / Clustering ─────────────────────────────────────────────
CLUSTERING_RANDOM_SEED=42
CLUSTERING_K_MIN=2
CLUSTERING_K_MAX=10
